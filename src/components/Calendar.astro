---
---
<section class="glass-panel calendar-card">
  <div class="section-header">
    <div>
      <span class="section-tag">Calendario activo</span>
      <h3 id="calendar-title">Mes actual</h3>
    </div>
    <span id="calendar-date" class="date-note"></span>
  </div>
  <div class="calendar-toolbar">
    <button id="prev-month" class="button secondary small">‹</button>
    <div id="calendar-month-label" class="calendar-month-label"></div>
    <button id="next-month" class="button secondary small">›</button>
  </div>
  <div id="calendar-grid" class="calendar-grid"></div>
  <div id="calendar-events" class="calendar-events"></div>
</section>

<script is:inline>
  const holidays = {
    '1-1': 'Año Nuevo',
    '5-1': 'Día del Trabajador',
    '12-25': 'Navidad',
    '12-31': 'Fin de año'
  };

  const specialDates = {
    '5-10': 'Evento importante',
    '6-15': 'Capacitación técnica',
    '7-20': 'Revisión de sistema'
  };

  const dayNames = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
  const today = new Date();
  let currentDate = new Date(today.getFullYear(), today.getMonth(), 1);
  let selectedDate = today;

  const title = document.getElementById('calendar-title');
  const dateLabel = document.getElementById('calendar-date');
  const monthLabel = document.getElementById('calendar-month-label');
  const calendarGrid = document.getElementById('calendar-grid');
  const calendarEvents = document.getElementById('calendar-events');

  const prevButton = document.getElementById('prev-month');
  const nextButton = document.getElementById('next-month');

  function formatMonth(date) {
    return date.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
  }

  function setInfo() {
    title.textContent = 'Calendario activo';
    dateLabel.textContent = `Hoy: ${today.toLocaleDateString('es-ES')}`;
    monthLabel.textContent = formatMonth(currentDate);
  }

  function getDayKey(date) {
    return `${date.getMonth() + 1}-${date.getDate()}`;
  }

  function getConfig() {
    return window.PORTAFOLIO_CONFIG?.calendar ?? { showEvents: true, showHolidays: true };
  }

  function getNotes(date) {
    const key = getDayKey(date);
    const note = holidays[key] || specialDates[key] || '';
    const config = getConfig();
    if (!config.showEvents) return '';
    if (!config.showHolidays && holidays[key]) return '';
    return note;
  }

  function buildCalendar() {
    calendarGrid.innerHTML = '';
    dayNames.forEach(day => {
      const cell = document.createElement('div');
      cell.className = 'calendar-day-name';
      cell.textContent = day;
      calendarGrid.appendChild(cell);
    });

    const firstDayIndex = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1).getDay();
    const monthLength = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0).getDate();

    for (let i = 0; i < firstDayIndex; i++) {
      const empty = document.createElement('div');
      empty.className = 'calendar-cell empty';
      calendarGrid.appendChild(empty);
    }

    for (let date = 1; date <= monthLength; date++) {
      const cell = document.createElement('button');
      cell.type = 'button';
      cell.className = 'calendar-cell date-cell';
      const cellDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), date);
      const note = getNotes(cellDate);
      const isToday = cellDate.toDateString() === today.toDateString();
      const isSelected = cellDate.toDateString() === selectedDate.toDateString();

      if (note) cell.classList.add('calendar-highlight');
      if (isToday) cell.classList.add('calendar-today');
      if (isSelected) cell.classList.add('calendar-selected');

      const label = document.createElement('span');
      label.textContent = date;
      cell.appendChild(label);

      if (note) {
        const noteLabel = document.createElement('small');
        noteLabel.textContent = note;
        cell.appendChild(noteLabel);
      }

      cell.addEventListener('click', () => {
        selectedDate = cellDate;
        renderSelectedInfo();
        buildCalendar();
      });

      calendarGrid.appendChild(cell);
    }
  }

  function renderSelectedInfo() {
    const selectedNote = getNotes(selectedDate);
    const config = getConfig();
    calendarEvents.innerHTML = `
      <div class="calendar-selected-info">
        <strong>${selectedDate.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' })}</strong>
        <span>${selectedNote || 'Ninguna fecha importante'}</span>
      </div>
      <h4>Fechas clave</h4>
    `;

    if (!config.showEvents) {
      calendarEvents.innerHTML += '<div class="calendar-event"><span>Las fechas importantes están desactivadas en configuración.</span></div>';
      return;
    }

    const entries = [...new Map([...Object.entries(holidays), ...Object.entries(specialDates)]).entries()];
    calendarEvents.innerHTML += entries.map(([key, text]) => {
      const [m, d] = key.split('-').map(Number);
      const date = new Date(currentDate.getFullYear(), m - 1, d).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
      return `<div class="calendar-event"><strong>${date}</strong><span>${text}</span></div>`;
    }).join('');
  }

  function changeMonth(offset) {
    currentDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + offset, 1);
    setInfo();
    buildCalendar();
    renderSelectedInfo();
  }

  prevButton.addEventListener('click', () => changeMonth(-1));
  nextButton.addEventListener('click', () => changeMonth(1));

  setInfo();
  buildCalendar();
  renderSelectedInfo();
</script>
